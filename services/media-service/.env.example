PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/fotokita_media

# Storage (Cloudflare R2)
R2_REGION=auto
R2_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=fotokita

# Auth for DELETE /media/wedding/:weddingId and proxy-image
ADMIN_SERVICE_URL=http://localhost:3002
# Shared secret that tenant-service sends as x-service-key (same value in both .env files)
INTERNAL_API_KEY=generate-a-long-random-value
# Extra hosts proxy-image may fetch from (the R2/S3 endpoint host is allowed automatically)
PROXY_ALLOWED_HOSTS=
